# --------------------------------------------------
# Active config (loaded by api_gateway/manage.py and
# auth_service/manage.py via python-dotenv).
#
# All requests go through the gateway on GATEWAY_PORT.
# Every other service below is internal-only - the
# frontend never talks to these ports directly.
#
# To add a new backend service:
#   1. Run it on its own port (add a line below).
#   2. Add one entry to SERVICE_URLS in
#      api_gateway/config/settings.py.
#   3. Add one path() line in api_gateway/gateway/urls.py.
# No new proxy class needed - gateway/views/proxy.py is generic.
# --------------------------------------------------
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://127.0.0.1:8001
MASTER_SERVICE_URL=http://127.0.0.1:8003
SALES_SERVICE_URL=http://127.0.0.1:8004

